@page "/"
@page "/satellites"
@implements IDisposable
@inject OrbitWatcher.Client.Services.SatelliteStateService SatelliteState

<PageTitle>Satellites</PageTitle>

<h1>Satellite positions</h1>

<p><strong>Connection:</strong> @SatelliteState.Stream.Status</p>
<p><strong>Last update (UTC):</strong> @(SatelliteState.Stream.LastUpdateUtc?.ToString("O") ?? "—")</p>

@if (!string.IsNullOrWhiteSpace(SatelliteState.Stream.LastError))
{
    <p class="text-danger"><strong>Error:</strong> @SatelliteState.Stream.LastError</p>
}

<table class="table">
    <thead>
    <tr>
        <th>NoradCatId</th>
        <th>Name</th>
        <th>Lat</th>
        <th>Lon</th>
        <th>AltKm</th>
        <th>TimestampUtc</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var satellite in SatelliteState.Satellites.Values.OrderBy(x => x.NoradCatId))
    {
        <tr>
            <td>@satellite.NoradCatId</td>
            <td>@satellite.Name</td>
            <td>@satellite.Lat.ToString("F6")</td>
            <td>@satellite.Lon.ToString("F6")</td>
            <td>@satellite.AltKm.ToString("F2")</td>
            <td>@satellite.TimestampUtc.ToString("O")</td>
        </tr>
    }
    </tbody>
</table>

@code {
    protected override async Task OnInitializedAsync()
    {
        SatelliteState.StateChanged += OnStateChanged;
        await SatelliteState.EnsureStartedAsync();
    }

    private void OnStateChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        SatelliteState.StateChanged -= OnStateChanged;
    }
}
