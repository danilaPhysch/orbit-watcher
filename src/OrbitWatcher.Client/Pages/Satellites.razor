@page "/"
@page "/satellites"
@implements IDisposable
@inject OrbitWatcher.Client.Services.SatelliteStateService SatelliteState

<PageTitle>Satellites</PageTitle>

<h1>Satellite positions</h1>

<p><strong>Connection:</strong> @SatelliteState.Stream.Status</p>
<p><strong>Last update (Local):</strong> @(SatelliteState.Stream.LastUpdateUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? "—")</p>

@if (!string.IsNullOrWhiteSpace(SatelliteState.Stream.LastError))
{
    <p class="text-danger"><strong>Error:</strong> @SatelliteState.Stream.LastError</p>
}

<table class="table">
    <thead>
    <tr>
        <th>NoradCatId</th>
        <th>Name</th>
        <th>Constellation</th>
        <th>Lat</th>
        <th>Lon</th>
        <th>AltKm</th>
        <th>Vx (km/s)</th>
        <th>Vy (km/s)</th>
        <th>Vz (km/s)</th>
        <th>Speed (km/s)</th>
        <th>Period (min)</th>
        <th>Incl (°)</th>
        <th>Ecc</th>
        <th>Perigee (km)</th>
        <th>Apogee (km)</th>
        <th>Timestamp (Local)</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var satellite in SatelliteState.Satellites.Values.OrderBy(x => x.NoradCatId))
    {
        <tr>
            <td>@satellite.NoradCatId</td>
            <td>@satellite.Name</td>
            <td>@satellite.Constellation</td>
            <td>@satellite.Lat.ToString("F6")</td>
            <td>@satellite.Lon.ToString("F6")</td>
            <td>@satellite.AltKm.ToString("F2")</td>
            <td>@satellite.VelocityXKmS.ToString("F3")</td>
            <td>@satellite.VelocityYKmS.ToString("F3")</td>
            <td>@satellite.VelocityZKmS.ToString("F3")</td>
            <td>@satellite.SpeedKmS.ToString("F3")</td>
            <td>@satellite.OrbitalPeriodMin.ToString("F2")</td>
            <td>@satellite.InclinationDeg.ToString("F2")</td>
            <td>@satellite.Eccentricity.ToString("F6")</td>
            <td>@satellite.PerigeeKm.ToString("F2")</td>
            <td>@satellite.ApogeeKm.ToString("F2")</td>
            <td>@satellite.TimestampUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
        </tr>
    }
    </tbody>
</table>

@code {
    protected override async Task OnInitializedAsync()
    {
        SatelliteState.StateChanged += OnStateChanged;
        await SatelliteState.EnsureStartedAsync();
    }

    private void OnStateChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        SatelliteState.StateChanged -= OnStateChanged;
    }
}
