@page "/map"
@implements IDisposable
@inject OrbitWatcher.Client.Services.SatelliteStateService SatelliteState
@inject ILogger<OrbitWatcher.Client.Pages.Map> Logger

<PageTitle>Map</PageTitle>

<h1>Satellite map</h1>

<p><strong>Connection:</strong> @SatelliteState.Stream.Status</p>
<p><strong>Last update (UTC):</strong> @(SatelliteState.Stream.LastUpdateUtc?.ToString("O") ?? "—")</p>

@if (!string.IsNullOrWhiteSpace(SatelliteState.Stream.LastError))
{
    <p class="text-danger"><strong>Error:</strong> @SatelliteState.Stream.LastError</p>
}

@if (_activeNoradCatId.HasValue)
{
    var activeSat = SatelliteState.Satellites.GetValueOrDefault(_activeNoradCatId.Value);
    <p>
        <strong>Selected:</strong>
        @(activeSat?.Name ?? "Unknown") (NORAD @_activeNoradCatId.Value)
        <button class="btn btn-sm btn-outline-secondary ms-2" @onclick="DeselectSatellite">✕</button>
    </p>
}

@if (!string.IsNullOrWhiteSpace(_groundTrackError))
{
    <p class="text-warning"><strong>Ground track error:</strong> @_groundTrackError</p>
}

<SatelliteMap Satellites="SatelliteState.Satellites.Values.ToArray()"
             GroundTrack="_groundTrack"
             OnMarkerClicked="OnMarkerClickedAsync" />

@code {
    private uint? _activeNoradCatId;
    private OrbitWatcher.Contracts.GroundTrackDto? _groundTrack;
    private string? _groundTrackError;
    private System.Threading.Timer? _refreshTimer;
    private bool _isRefreshing;
    private static readonly TimeSpan GroundTrackRefreshInterval = TimeSpan.FromSeconds(30);

    protected override async Task OnInitializedAsync()
    {
        SatelliteState.StateChanged += OnStateChanged;
        await SatelliteState.EnsureStartedAsync();
    }

    private void OnStateChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task OnMarkerClickedAsync(uint noradCatId)
    {
        if (_activeNoradCatId == noradCatId)
        {
            return;
        }

        _activeNoradCatId = noradCatId;
        await LoadGroundTrackAsync();
        StartRefreshTimer();
        StateHasChanged();
    }

    private void DeselectSatellite()
    {
        _activeNoradCatId = null;
        _groundTrack = null;
        _groundTrackError = null;
        StopRefreshTimer();
        StateHasChanged();
    }

    private async Task LoadGroundTrackAsync()
    {
        if (!_activeNoradCatId.HasValue)
        {
            _groundTrack = null;
            _groundTrackError = null;
            return;
        }

        try
        {
            _groundTrack = await SatelliteState.Stream.GetGroundTrackAsync(_activeNoradCatId.Value);
            _groundTrackError = null;
        }
        catch (Exception ex)
        {
            _groundTrack = null;
            _groundTrackError = ex.Message;
            Logger.LogWarning(ex, "Failed to load ground track for NORAD {NoradCatId}.", _activeNoradCatId.Value);
        }
    }

    private void StartRefreshTimer()
    {
        StopRefreshTimer();
        _refreshTimer = new System.Threading.Timer(
            _ => _ = InvokeAsync(async () =>
            {
                if (_isRefreshing) return;
                _isRefreshing = true;
                try
                {
                    await LoadGroundTrackAsync();
                    StateHasChanged();
                }
                finally
                {
                    _isRefreshing = false;
                }
            }),
            null,
            GroundTrackRefreshInterval,
            GroundTrackRefreshInterval
        );
    }

    private void StopRefreshTimer()
    {
        _refreshTimer?.Dispose();
        _refreshTimer = null;
    }

    public void Dispose()
    {
        SatelliteState.StateChanged -= OnStateChanged;
        StopRefreshTimer();
    }
}
