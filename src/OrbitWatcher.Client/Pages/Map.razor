@page "/map"
@implements IDisposable
@inject OrbitWatcher.Client.Services.SatellitePositionsStream Stream

<PageTitle>Map</PageTitle>

<h1>Satellite map</h1>

<p><strong>Connection:</strong> @Stream.Status</p>
<p><strong>Last update (UTC):</strong> @(Stream.LastUpdateUtc?.ToString("O") ?? "—")</p>

@if (!string.IsNullOrWhiteSpace(Stream.LastError))
{
    <p class="text-danger"><strong>Error:</strong> @Stream.LastError</p>
}

@if (_activeNoradCatId.HasValue)
{
    var activeSat = _satellites.GetValueOrDefault(_activeNoradCatId.Value);
    <p>
        <strong>Selected:</strong>
        @(activeSat?.Name ?? "Unknown") (NORAD @_activeNoradCatId.Value)
        <button class="btn btn-sm btn-outline-secondary ms-2" @onclick="DeselectSatellite">✕</button>
    </p>
}

<SatelliteMap Satellites="_satellites.Values.ToArray()"
             GroundTrack="_groundTrack"
             OnMarkerClicked="OnMarkerClickedAsync" />

@code {
    private readonly Dictionary<uint, OrbitWatcher.Contracts.SatellitePositionDto> _satellites = [];
    private uint? _activeNoradCatId;
    private OrbitWatcher.Contracts.GroundTrackDto? _groundTrack;
    private System.Threading.Timer? _refreshTimer;
    private static readonly TimeSpan GroundTrackRefreshInterval = TimeSpan.FromSeconds(30);

    protected override async Task OnInitializedAsync()
    {
        Stream.PositionsReceived += OnPositionsReceived;
        Stream.StatusChanged += OnStatusChanged;

        await Stream.StartAsync();
    }

    private void OnPositionsReceived(IReadOnlyCollection<OrbitWatcher.Contracts.SatellitePositionDto> positions)
    {
        foreach (var satellite in positions)
        {
            _satellites[satellite.NoradCatId] = satellite;
        }

        _ = InvokeAsync(StateHasChanged);
    }

    private void OnStatusChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task OnMarkerClickedAsync(uint noradCatId)
    {
        if (_activeNoradCatId == noradCatId)
        {
            return;
        }

        _activeNoradCatId = noradCatId;
        await LoadGroundTrackAsync();
        StartRefreshTimer();
        StateHasChanged();
    }

    private void DeselectSatellite()
    {
        _activeNoradCatId = null;
        _groundTrack = null;
        StopRefreshTimer();
        StateHasChanged();
    }

    private async Task LoadGroundTrackAsync()
    {
        if (!_activeNoradCatId.HasValue)
        {
            _groundTrack = null;
            return;
        }

        try
        {
            _groundTrack = await Stream.GetGroundTrackAsync(_activeNoradCatId.Value);
        }
        catch
        {
            _groundTrack = null;
        }
    }

    private void StartRefreshTimer()
    {
        StopRefreshTimer();
        _refreshTimer = new System.Threading.Timer(
            _ => _ = InvokeAsync(async () =>
            {
                await LoadGroundTrackAsync();
                StateHasChanged();
            }),
            null,
            GroundTrackRefreshInterval,
            GroundTrackRefreshInterval
        );
    }

    private void StopRefreshTimer()
    {
        _refreshTimer?.Dispose();
        _refreshTimer = null;
    }

    public void Dispose()
    {
        Stream.PositionsReceived -= OnPositionsReceived;
        Stream.StatusChanged -= OnStatusChanged;
        StopRefreshTimer();
    }
}
