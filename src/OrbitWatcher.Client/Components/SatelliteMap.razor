@implements IAsyncDisposable
@inject OrbitWatcher.Client.Services.LeafletMapInterop MapInterop

<div class="satellite-map" @ref="_mapElement"></div>

@code {
    [Parameter]
    public IReadOnlyCollection<OrbitWatcher.Contracts.SatellitePositionDto> Satellites { get; set; } = [];

    [Parameter]
    public string? MapId { get; set; }

    [Parameter]
    public double CenterLat { get; set; } = 15;

    [Parameter]
    public double CenterLon { get; set; }

    [Parameter]
    public int Zoom { get; set; } = 2;

    [Parameter]
    public uint? ActiveSatelliteId { get; set; }

    [Parameter]
    public EventCallback<uint?> ActiveSatelliteIdChanged { get; set; }

    [Parameter]
    public OrbitWatcher.Contracts.GroundTrackDto? GroundTrack { get; set; }

    private ElementReference _mapElement;
    private bool _isInitialized;
    private string _resolvedMapId = string.Empty;
    private DotNetObjectReference<SatelliteMap>? _objRef;

    protected override void OnInitialized()
    {
        _resolvedMapId = string.IsNullOrWhiteSpace(MapId)
            ? $"satellite-map-{Guid.NewGuid():N}"
            : MapId;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _objRef = DotNetObjectReference.Create(this);
        await MapInterop.InitializeAsync(_resolvedMapId, _mapElement, CenterLat, CenterLon, Zoom, _objRef);
        _isInitialized = true;
        await SyncMarkersAsync();
        await SyncGroundTrackAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_isInitialized)
        {
            return;
        }

        await SyncMarkersAsync();
        await SyncGroundTrackAsync();
    }

    [JSInvokable]
    public async Task OnSatelliteSelected(uint noradCatId)
    {
        await ActiveSatelliteIdChanged.InvokeAsync(noradCatId);
    }

    private async Task SyncMarkersAsync()
    {
        var snapshot = Satellites as OrbitWatcher.Contracts.SatellitePositionDto[] ?? Satellites.ToArray();
        var noradIds = new uint[snapshot.Length];
        for (var i = 0; i < snapshot.Length; i++)
        {
            noradIds[i] = snapshot[i].NoradCatId;
        }

        await MapInterop.UpsertMarkersAsync(_resolvedMapId, snapshot);
        await MapInterop.RemoveMarkersExceptAsync(_resolvedMapId, noradIds);
    }

    private async Task SyncGroundTrackAsync()
    {
        if (GroundTrack is not null && GroundTrack.NoradCatId == ActiveSatelliteId)
        {
            await MapInterop.DrawGroundTrackAsync(_resolvedMapId, GroundTrack);
        }
        else
        {
            await MapInterop.ClearGroundTrackAsync(_resolvedMapId);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _objRef?.Dispose();
        if (!_isInitialized)
        {
            return;
        }

        await MapInterop.DisposeMapAsync(_resolvedMapId);
    }
}
